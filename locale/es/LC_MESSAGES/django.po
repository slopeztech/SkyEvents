msgid "Script data"
msgstr "Datos de script"

msgid "Script configuration file"
msgstr "Archivo de configuración del script"

msgid "Download script data"
msgstr "Descargar datos de script"

msgid "Download .json"
msgstr "Descargar .json"

msgid "Actions"
msgstr "Acciones"

msgid "What is this file and why is it needed?"
msgstr "¿Qué es este archivo y para qué sirve?"

msgid "This JSON file must be placed in the same directory as the SkyEvents reporting script on the station owner's computer. The script reads this file at startup to know which station, cameras and radio receivers it is authorised to report events for, and to authenticate with the SkyEvents server."
msgstr "Este archivo JSON debe colocarse en el mismo directorio que el script de reporte de SkyEvents en el ordenador del propietario de la estación. El script lo lee al arrancar para saber qué estación, cámaras y radios está autorizado a reportar, y para autenticarse con el servidor de SkyEvents."

msgid "user_token"
msgstr "user_token"

msgid "Unique secret that identifies this user's account. Keep it confidential."
msgstr "Secreto único que identifica la cuenta de este usuario. Mantenlo confidencial."

msgid "hash_id"
msgstr "hash_id"

msgid "Short unique identifier for each device (station / camera / radio). Used for log correlation."
msgstr "Identificador único corto de cada dispositivo (estación / cámara / radio). Se usa para correlacionar registros."

msgid "If the user_token is compromised, contact an administrator to regenerate it."
msgstr "Si el user_token queda comprometido, contacta con un administrador para regenerarlo."

msgid "JSON file preview"
msgstr "Vista previa del archivo JSON"

msgid "Copy"
msgstr "Copiar"

msgid "Copied!"
msgstr "¡Copiado!"

msgid "No cameras or radios registered for this station yet."
msgstr "Esta estación aún no tiene cámaras ni radios registradas."

msgid "This user has no stations yet. Script data will be empty."
msgstr "Este usuario aún no tiene estaciones. Los datos de script estarán vacíos."

msgid "Hash ID"
msgstr "Hash ID"

msgid "Short unique identifier used in script configuration files."
msgstr "Identificador único corto utilizado en los archivos de configuración del script."

msgid "Script token"
msgstr "Token de script"

msgid "Unique secret token that the reporting script uses to authenticate. Never share this token publicly."
msgstr "Token secreto único que el script de reporte usa para autenticarse. No lo compartas públicamente."


msgid "Camera type"
msgstr "Tipo de cámara"

msgid "Type of camera: 'Fixed' points to a specific direction (azimuth/elevation required), 'All-sky' covers the full dome (180 °), 'Wide-angle' covers a broad area without full coverage."
msgstr "Tipo de cámara: 'Fija' apunta a una dirección específica (azimut/elevación requeridos), 'Todo cielo' cubre el domo completo (180 °), 'Gran angular' cubre un área amplia sin cobertura total."

msgid "Fixed"
msgstr "Fija"

msgid "All-sky"
msgstr "Todo cielo"

msgid "Wide-angle"
msgstr "Gran angular"

msgid "Azimuth and elevation are required for Fixed cameras."
msgstr "Las cámaras fijas requieren azimut y elevación."